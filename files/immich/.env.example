# Подстановка переменных в docker-compose.yaml (в контейнеры напрямую не попадает).
# Скопируйте в files/immich/.env и заполните; зашифровать: ansible-vault encrypt files/immich/.env

# Версии. Закрепите конкретные (например v2.2.0): новая версия Immich мигрирует базу при старте.
IMMICH_VERSION=release
IMMICHFRAME_VERSION=latest

# Каталог с библиотекой на хосте (общий для узлов, например NFS): <UPLOAD_LOCATION>/library
UPLOAD_LOCATION=/immich

# Адрес Immich для Telegram-бота
IMMICH_URL=https://photo.example.com

# Пароль админки фоторамок ImmichFrame
IMMICHFRAME_ADMIN_PASSWORD=CHANGE_ME

# Файл сессии Telethon на хосте рядом с docker-compose.yaml (у каждого узла свой)
TELEGRAM_SESSION_FILE=./telegram.session

# DNS для контейнеров и подсеть Docker-сети immich (одинаковая на всех узлах)
DNS_SERVER=1.1.1.1
IMMICH_SUBNET=172.28.1.160/28
