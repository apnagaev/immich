# Переменные контейнеров immich-server и immich-machine-learning.
# Скопируйте в files/immich/immich.env; зашифровать: ansible-vault encrypt files/immich/immich.env
# Все параметры: https://immich.app/docs/install/environment-variables

TZ=Europe/Moscow

# Внешний PostgreSQL (с расширением VectorChord) и Redis, общие для обоих узлов
DB_URL=postgresql://immich:CHANGE_ME@db.example.com:5432/immich
REDIS_HOSTNAME=redis.example.com
REDIS_PORT=6379

# IP reverse proxy, которым можно доверять X-Forwarded-For
IMMICH_TRUSTED_PROXIES=10.0.0.10,10.0.0.11

CPU_CORES=6
IMMICH_PROCESS_INVALID_IMAGES=true

# Машинное обучение: держать модели в памяти постоянно (0 — не выгружать)
MACHINE_LEARNING_MODEL_TTL=0
MACHINE_LEARNING_REQUEST_THREADS=6
